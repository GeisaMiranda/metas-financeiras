{
  "expo": {
    "name": "Metas Financeiras",
    "slug": "metas-financeiras",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": { "image": "./assets/splash.png", "resizeMode": "contain", "backgroundColor": "#0F766E" },
    "ios": { "supportsTablet": false, "bundleIdentifier": "com.metasfinanceiras.app" },
    "android": {
      "package": "com.metasfinanceiras.app",
      "versionCode": 1,
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#0F766E" }
    },
    "plugins": [
      "expo-sqlite",
      ["expo-notifications", { "icon": "./assets/notification-icon.png", "color": "#0F766E" }]
    ]
  }
}
